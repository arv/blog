---
permalink: /atom.xml
eleventyExcludeFromCollections: true
# Render posts first so their content is available here.
eleventyImport:
  collections: [posts]
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
	<title>{{ site.title }}</title>
	<subtitle>{{ site.description }}</subtitle>
	<link href="{{ site.url }}/atom.xml" rel="self" />
	<link href="{{ site.url }}/" />
	<updated>{{ collections.posts | getNewestCollectionItemDate | rfc3339 }}</updated>
	<id>{{ site.url }}/</id>
	<author>
		<name>{{ site.author }}</name>
	</author>
	<generator>Eleventy</generator>
{% for post in collections.posts | head(20) %}
	<entry>
		<title>{{ post.data.title | stripHtml }}</title>
		<link href="{{ site.url }}{{ post.url }}" />
		<updated>{{ post.date | rfc3339 }}</updated>
		<published>{{ post.date | rfc3339 }}</published>
		<id>{{ site.url }}{{ post.url }}</id>
		{% for tag in post.data.tags %}<category term="{{ tag }}" />
		{% endfor %}
		<content type="html"><![CDATA[{{ post.templateContent | htmlToAbsoluteUrls(site.url + post.url) | safe }}]]></content>
	</entry>
{% endfor %}
</feed>
