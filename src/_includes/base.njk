<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title | safe }} &larr; {% endif %}{{ site.title }}{% if not title %} &larr; {{ site.tagline }}{% endif %}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="stylesheet" href="/css/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Yanone+Kaffeesatz:wght@200;300;400&display=swap">
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }} &raquo; Feed" href="{{ site.url }}/feed.xml">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }} &raquo; Atom Feed" href="{{ site.url }}/atom.xml">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if type == "post" %}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title | stripHtml }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% set thisPost = collections.posts | findByUrl(page.url) %}{% if thisPost %}<meta property="og:description" content="{{ thisPost.templateContent | excerpt(30) }}">{% endif %}
<meta property="article:published_time" content="{{ date | dateIso }}">
{% endif %}
</head>
<body class="{{ bodyClass or 'home blog' }}">

<div id="banner-bg" class="cf">
	<div id="banner" class="row">
		<div id="logo-area" class="col5">
			<h1 id="sitetitle">
				<a href="/">{{ site.title | firstpart | safe }}</a>
			</h1>
			<p id="tagline">{{ site.tagline }}</p>
		</div>
	</div>
</div>

<a href="/feed.xml" class="rsslink" title="Subscribe to RSS Feed"></a>

<div id="breadcrumbs1-bg">
	<nav id="breadcrumbs1" class="breadcrumbs lw">
		<ol>
			<li class="bc-home"><a href="/" title="Home">&nbsp;</a></li>
			<li><span class="bc-current">{% if breadcrumb %}{{ breadcrumb | safe }}{% elif title %}{{ title | stripHtml }}{% else %}Blog{% endif %}</span></li>
		</ol>
	</nav>
</div>

<div id="main" class="row">

	<div id="content" class="cf col8">
		{{ content | safe }}
	</div>

	<div id="widgetarea-one" class="col4">
		{% include "sidebar.njk" %}
	</div>

</div>

<div id="footer-bg">
	<div id="footer" class="lw">
		<p>&copy; 2004&ndash;{{ "now" | dateFormat("yyyy") }} {{ site.title }} &mdash; All Rights Reserved.</p>
		<p class="credit-link">Built with <a href="https://www.11ty.dev/">Eleventy</a>. <a href="{{ site.repo }}">Source on GitHub</a>.</p>
	</div>
</div>

</body>
</html>
