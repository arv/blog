---
layout: base.njk
pagination:
  data: collections.months
  size: 1
  alias: month
permalink: "/archives/{{ month.key }}/"
eleventyComputed:
  title: "{{ month.label }}"
bodyClass: archive date
eleventyExcludeFromCollections: true
# Render posts first so their content is available here.
eleventyImport:
  collections: [posts]
---
<h2 class="page-title">Archive: <span>{{ month.label }}</span></h2>

<div class="post-list">
{% for post in month.posts %}
	{% include "post-list-item.njk" %}
{% endfor %}
</div>
