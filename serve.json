{
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/feed", "destination": "/feed.xml" },
    { "source": "/feed/", "destination": "/feed.xml" },
    { "source": "/feed/atom", "destination": "/atom.xml" },
    { "source": "/feed/atom/", "destination": "/atom.xml" },
    { "source": "/feed/rss", "destination": "/feed.xml" },
    { "source": "/feed/rss/", "destination": "/feed.xml" },
    { "source": "/feed/rss2", "destination": "/feed.xml" },
    { "source": "/feed/rss2/", "destination": "/feed.xml" }
  ],
  "headers": [
    { "source": "**/*.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] },
    { "source": "**/*.{png,ico,jpg,jpeg,gif,svg,css}", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
